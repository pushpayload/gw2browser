# Top-level build output
build/
bin/
bin.gcc/
bind/
obj/
objs/
share/
tmp/

# Dependencies downloaded by build-linux.sh (not vendored submodules)
extern/wxWidgets/
extern/openal-soft/
extern/mpg123/

# CMake out-of-tree build dirs under extern
extern/gw2dattools/build/
extern/gw2formats/build/
extern/glew/build/
extern/freetype/build/
extern/libogg/build/
extern/libvorbis/build/
extern/libwebp/build/
extern/tinyxml2/build/
extern/wxWidgets/build-cmake/

# GLEW shipped binaries (Windows)
extern/glew/lib/

# Autotools products from in-tree ./configure && make
extern/**/autom4te.cache/
extern/**/.deps/
extern/**/.libs/
extern/**/config.status
extern/**/config.log
extern/**/libtool
extern/**/stamp-h1
extern/**/config.h
extern/**/configure.lineno
extern/**/configure~
extern/**/config.h.in~
